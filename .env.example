# Postgres (docker compose up -d gives you this one)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealfeed
DEALFEED_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealfeed_test

# Where raw source files are kept untouched (local folder for now; R2/S3 later)
DEALFEED_RAW_DIR=./data/raw

# Optional: Claude for gray-zone matching and NAICS classification
DEALFEED_LLM=off
ANTHROPIC_API_KEY=
DEALFEED_LLM_MODEL=claude-haiku-5-5

# Matching thresholds (0-100). >= AUTO links automatically; GRAY..AUTO goes to LLM/review.
DEALFEED_MATCH_AUTO=92
DEALFEED_MATCH_GRAY=80

# stdio MCP server (your own Claude Desktop): which user the calls run as
DEALFEED_LOCAL_USER=you@example.com

# Public URL of the hosted MCP server (used in OAuth metadata)
DEALFEED_PUBLIC_URL=http://localhost:8001
